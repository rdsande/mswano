# EmailJS credentials — copy this file to .env.local and fill in your values
# Sign up at https://www.emailjs.com, create a service and two email templates.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=your_contact_template_id
NEXT_PUBLIC_EMAILJS_BOOKING_TEMPLATE_ID=your_booking_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# ── Contact template variables ──────────────────────────────────────────────
# {{from_name}}   — sender's full name
# {{from_email}}  — sender's email
# {{phone}}       — sender's phone number
# {{message}}     — message body
# Set "To Email" in the template to: rodgers@tekleodigital.co.tz

# ── Booking template variables ───────────────────────────────────────────────
# {{from_name}}       — guest full name
# {{from_email}}      — guest email
# {{phone}}           — guest phone
# {{check_in}}        — check-in date
# {{check_out}}       — check-out date
# {{guests}}          — number of guests
# {{apartment_type}}  — apartment type
# {{special_requests}}— special requests
# Set "To Email" in the template to: rodgers@tekleodigital.co.tz
